    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:ip": "node -e \"const os = require('os'); const interfaces = os.networkInterfaces(); let ip = 'localhost'; for (const name of Object.keys(interfaces)) { for (const interface of interfaces[name]) { if (interface.family === 'IPv4' && !interface.internal) { ip = interface.address; break; } } if (ip !== 'localhost') break; } console.log('\\n🚀 Server starting...'); console.log('📱 Local: http://localhost:3000'); console.log('🌐 Network: http://' + ip + ':3000\\n');\" && next dev -H 0.0.0.0 -p 3000",
